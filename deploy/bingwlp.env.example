# =============================================================================
# BingWLP — variabili d'ambiente del backend (produzione, nginx + systemd)
# =============================================================================
#
# Modello da copiare in /etc/bingwlp/bingwlp.env:
#
#   sudo install -m 0640 -o root -g bingwlp deploy/bingwlp.env.example /etc/bingwlp/bingwlp.env
#
# Viene letto da systemd tramite `EnvironmentFile=/etc/bingwlp/bingwlp.env`.
# Sintassi: UNA variabile per riga, formato CHIAVE=valore, NIENTE `export`,
# niente virgolette necessarie; `#` a inizio riga = commento.
#
# Il backend legge le env con zod usando `.catch(default)`: una variabile
# mancante o con valore non valido NON fa fallire l'avvio, ricade sul default.
# I default del contratto sono in docs/API.md (sezione "Variabili d'ambiente
# (backend)") e replicati qui sotto come commento.
# =============================================================================


# -----------------------------------------------------------------------------
# --- Server: rete e processo ---
# -----------------------------------------------------------------------------

# Bind address. Con nginx reverse proxy sullo stesso host si DEVE restare in
# loopback: il backend non va mai esposto pubblicamente.
# Default contratto: 0.0.0.0 (comodo in Docker/sviluppo, da evitare qui).
HOST=127.0.0.1

# Porta HTTP del processo Node. Deve combaciare con il `proxy_pass` di
# deploy/nginx/bingwlp.conf (http://127.0.0.1:8080).
# Sopra la 1024 → nessuna capability richiesta dal servizio systemd.
# Default contratto: 8080.
PORT=8080

# Ambiente Node. In produzione SEMPRE `production`.
NODE_ENV=production

# Livello di log di pino (fatal|error|warn|info|debug|trace|silent).
# `debug` solo per diagnosi temporanea. Default contratto: info.
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# --- Bing upstream ---
# -----------------------------------------------------------------------------

# Market di default quando la query `?mkt=` non è specificata.
# Formato ^[a-z]{2}-[A-Z]{2}$ (es. it-IT, en-US, de-DE).
# Default contratto: it-IT.
DEFAULT_MARKET=it-IT

# Base delle API upstream di Bing (categorie/temi e immagini per tema).
# Default contratto: https://services.bingapis.com/ge-apps/api/v2
BING_API_BASE=https://services.bingapis.com/ge-apps/api/v2

# Base del CDN immagini di Bing usata dagli URL di /api/image e /api/download.
# Default contratto: https://www.bing.com/th
# IMPORTANTE: se cambiate/aggiungete host qui, aggiungeteli anche a
# `img-src`/`media-src` della CSP in deploy/nginx/bingwlp.conf.
BING_CDN_BASE=https://www.bing.com/th

# Timeout (ms) delle chiamate verso Bing. Rete lenta → 10000.
# Default contratto: 8000.
UPSTREAM_TIMEOUT_MS=8000


# -----------------------------------------------------------------------------
# --- Cache in-memory (TTL + stale-while-error) ---
# -----------------------------------------------------------------------------

# TTL (secondi) della cache categorie/temi. Cambiano di rado → 6h.
# Default contratto: 21600 (6 ore).
CACHE_TTL_THEMES_SEC=21600

# TTL (secondi) della cache immagini per tema. Cambiano spesso → 1h.
# Default contratto: 3600 (1 ora).
CACHE_TTL_IMAGES_SEC=3600

# Limite (byte) della cache dei BYTE immagine usata dal proxy `mode=stream`.
# 2147483648 = 2 GiB. Con IMAGE_STORE=null è di fatto ininfluente.
# Presente in server/.env.example (non nella tabella di docs/API.md).
CACHE_IMAGE_BYTES=2147483648


# -----------------------------------------------------------------------------
# --- Frontend statico ---
# -----------------------------------------------------------------------------

# Serve il build del frontend da parte di Node.
#
# IN QUESTA CONFIGURAZIONE = false: gli asset li serve nginx da
# /var/www/bingwlp/web/dist (gzip, cache, header di sicurezza, TLS: tutto lì).
# Duplicare lo statico su Node sarebbe solo spreco di banda e di fd.
# Vedi docs/DEPLOY.md § "Perché nginx serve il frontend".
#
# ATTENZIONE: in Docker NON c'è nginx → il backend DEVE servire lo statico,
# quindi nel container va a `true` (lo impone deploy/docker-compose.yml con
# un override `environment:`, così non dipende da questo file).
# Default contratto: true.
SERVE_STATIC=false

# Cartella del build frontend. Assoluta, così non dipende dalla working
# directory del processo. Vale solo se SERVE_STATIC=true.
# Con il layout di deploy: /opt/bingwlp/current/web/dist (symlink al release).
# Default contratto: ../web/dist.
STATIC_DIR=/opt/bingwlp/current/web/dist


# -----------------------------------------------------------------------------
# --- Image store: storico immagini (NON IMPLEMENTATO) ---
# -----------------------------------------------------------------------------

# `null` = nessuno store (implementazione attiva: NullImageStore, no-op).
# `fs`   = scheletro FsImageStore presente nel codice ma NON attivo: abilitandolo
#          il backend logga un warning e lo storico non è completo. NON usarlo in
#          produzione: /api/image fa redirect (302) al CDN Bing.
# Default contratto: null.
IMAGE_STORE=null

# Cartella dello store (futuro). Se un giorno IMAGE_STORE=fs, questo deve
# puntare a un percorso scrivibile dal servizio: /var/lib/bingwlp/images
# (già incluso in ReadWritePaths= della unit systemd) e va fatto il backup
# con scripts/backup-images.sh.
# Default contratto: ./data/images.
IMAGE_STORE_DIR=/var/lib/bingwlp/images

# Nota: /var/lib/bingwlp è l'UNICA directory scrivibile dal servizio
# (ProtectSystem=strict + ReadWritePaths=/var/lib/bingwlp).
# Qualunque altro percorso di scrittura va aggiunto lì.


# -----------------------------------------------------------------------------
# --- Sicurezza / rete ---
# -----------------------------------------------------------------------------

# CORS. Vuoto = nessun header CORS: il frontend usa URL relativi `/api/...`
# ed è quindi same-origin (browser e API sullo stesso host via nginx).
# Popolare solo se serve esporre l'API a un'origine terza, es.:
#   ALLOW_ORIGINS=https://altra-app.example.com,http://localhost:5173
# Default contratto: vuoto.
ALLOW_ORIGINS=

# Rate limit per IP (richieste/minuto). 0 = disattivato.
# Con nginx davanti conviene limitare lì (`limit_req`), oppure qui con un valore
# prudente (es. 120). Occhio: con rate limit molto basso gli healthcheck
# (systemd/docker/uptime) possono incassare 429.
# Default contratto: 0 (off).
RATE_LIMIT_MAX=0

