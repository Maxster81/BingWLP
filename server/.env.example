# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- Bing upstream ---
DEFAULT_MARKET=it-IT
BING_API_BASE=https://services.bingapis.com/ge-apps/api/v2
BING_CDN_BASE=https://www.bing.com/th
UPSTREAM_TIMEOUT_MS=8000

# --- Cache ---
CACHE_TTL_THEMES_SEC=21600
CACHE_TTL_IMAGES_SEC=3600
CACHE_IMAGE_BYTES=2147483648

# --- Static frontend ---
SERVE_STATIC=true
STATIC_DIR=../web/dist

# --- Image store (futuro, non implementato) ---
IMAGE_STORE=null
IMAGE_STORE_DIR=./data/images

# --- Sicurezza / rete ---
ALLOW_ORIGINS=
RATE_LIMIT_MAX=0
